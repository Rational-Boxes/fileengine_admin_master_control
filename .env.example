# admin_master_control — copy to .env and fill in. /readyz names what is missing.

AMC_HOST=0.0.0.0
AMC_PORT=8103
# Loopback-only, deliberately: /healthz /readyz /metrics are unauthenticated.
AMC_MONITOR_HOST=127.0.0.1
AMC_MONITOR_PORT=8104

# Its own store — queue state and decisions. Not another service's schema.
AMC_PG_HOST=localhost
AMC_PG_PORT=5432
AMC_PG_DATABASE=admin_master_control
AMC_PG_USER=
AMC_PG_PASSWORD=

# ── the tenant registry ───────────────────────────────────────────────────
#
# The CORE's database. `public.tenants` is the ONE list of tenants and the one
# lifecycle state: provisioning writes it, the doors read it to decide whether a
# login is admitted, and this console reads and writes the same rows.
#
# There is deliberately no second tenants table here. This console briefly had one
# and it duplicated four state names with a separate writer — so a tenant the
# registry had suspended would still have read as `live` on the page whose job is to
# say what is happening. The core is a mandatory dependency, so the copy bought
# nothing.
#
# Separate from AMC_PG_* above, which is this application's OWN database. Falls back
# to the platform-wide FILEENGINE_PG_* when unset.
AMC_CORE_PG_HOST=localhost
AMC_CORE_PG_PORT=5434
AMC_CORE_PG_DATABASE=fileengine
AMC_CORE_PG_USER=
AMC_CORE_PG_PASSWORD=

# Read through APIs, never through schemas.
AMC_AUDIT_URL=
AMC_LDAP_MANAGER_URL=
# The stream is for latency only; the ledger is what gets displayed.
AMC_REDIS_URL=

# Deployment roles live outside every tenant OU. The prefix is what makes
# "refuse these in tenant context" one rule rather than a drifting list.
FILEENGINE_LDAP_URL=
FILEENGINE_LDAP_BASE_DN=
AMC_ROLE_PREFIX=system_

# A DISTINCT audience, so a tenant token cannot be accepted here.
AMC_TOKEN_AUDIENCE=fileengine-system-admin
AMC_JWT_SECRET=
# ── the second factor (§6) ────────────────────────────────────────────────
#
# DEFAULT ON, and opting out is explicit: AMC_REQUIRE_MFA=false. Both /readyz and
# the startup log report it, so a deployment cannot admit the cross-tenant console
# on a password alone without the fact being visible.
#
# "Required" means VERIFIED, and it implies FORCED ENROLMENT on first login: an
# administrator with no factor gets an enrolment-only challenge and nothing else
# until they finish. It used to mean the caller had CLAIMED a factor, which made it
# decorative — `second_factor` was a self-asserted string, so {"second_factor":
# "totp"} bought a fully MFA-marked token.
AMC_REQUIRE_MFA=true

# Where the factor lives. ldap_manager owns `user_2fa`, keyed by uid ALONE and
# shared across tenants, so an administrator who enrolled through a tenant already
# has a factor this tier can verify — one enrolment, not one per door.
#
# Required while AMC_REQUIRE_MFA is true. Unset is a MISCONFIGURATION, not a
# silent pass: /readyz reports it and every login is refused, because enforcement
# that cannot reach its source must not wave everyone through.
AMC_MFA_URL=http://localhost:8093
# MUST MATCH ldap_manager's MFA_INTERNAL_SECRET. Its /internal/2fa/* endpoints
# answer 404 when their own secret is unset and 403 on a mismatch, and this
# console treats both as "cannot check" rather than "nobody is enrolled" —
# otherwise a wrong secret would hand out sessions.
AMC_MFA_INTERNAL_SECRET=

# The methods permitted AT THIS TIER, narrower than the deployment cap on purpose.
# `email` is excluded: it is the weakest path on offer and this is the console that
# reads every tenant's audit. `recovery` is kept, because losing the only factor
# here means nobody can grant authority to anybody.
AMC_MFA_METHODS=totp,recovery

# NOT a real tenant, and it must never name one. ldap_manager's internal 2FA
# endpoints are tenant-addressed and resolve methods as "deployment cap ∩ that
# tenant's policy", so passing a real tenant would let ITS administrator disable
# TOTP and thereby block enrolment for this console. A tenant with no policy row
# inherits the full cap.
AMC_MFA_TENANT_CONTEXT=__deployment__
# The window between a correct password and a proven factor. Short.
AMC_MFA_CHALLENGE_TTL_S=600

# The first system_owner, applied once at startup (§6.3). Startup refuses to
# add a second owner from this value — an existing owner grants further ones.
AMC_BOOTSTRAP_OWNER=james@rationalboxes.com
# system_owner grants authority but does not hold the operational roles, so the
# first administrator also receives the four unless this is false.
AMC_BOOTSTRAP_OWNER_ALL_ROLES=true

# Where deployment authority is read from. MUST NOT be a tenant OU or the
# directory root — this tier grants from it, and widening it is the mirror of
# the defect the tenant doors were fixed for on 2026-09-29.
AMC_LDAP_ROLE_OU=ou=system
AMC_LDAP_USER_OU=ou=users

# The credential this application reads the audit ledger with. NOT a
# system_admin token — that role is the core's ACL bypass and reads every file
# in every tenant. audit_service grants the global audit read to the deployment
# roles instead (its AUDIT_DEPLOYMENT_READ_ROLES).
AMC_AUDIT_TOKEN=
